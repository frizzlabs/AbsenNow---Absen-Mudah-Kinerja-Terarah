# ─── APP ──────────────────────────────────────────────────────────────────────
# Salin file ini jadi `env.production` di server, lalu isi nilai-nilai rahasianya.
# JANGAN commit `env.production` (sudah di-gitignore).
APP_NAME=AbsenNow
APP_ENV=production
APP_KEY=                          # Generate dengan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://hadirnow.jaritechnology.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── LOGGING ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # Jangan debug di production

# ─── DATABASE (PostgreSQL) ────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db                        # Docker: nama service compose (BUKAN 127.0.0.1)
DB_PORT=5432
DB_DATABASE=absen_now_prod        # Nama database di server
DB_USERNAME=absennow_user         # User DB di server
DB_PASSWORD=                      # Isi dengan password kuat di server

# ─── FRONTEND URL (untuk CORS) ────────────────────────────────────────────────
FRONTEND_URL=https://hadirnow.jaritechnology.com

# ─── SANCTUM (mobile app) ─────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=hadirnow.jaritechnology.com

# ─── SESSION ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.jaritechnology.com
SESSION_SECURE_COOKIE=true

# ─── CACHE & QUEUE ────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── MAIL (Resend) ────────────────────────────────────────────────────────────
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@jaritechnology.com"
MAIL_FROM_NAME="AbsenNow"
RESEND_API_KEY=                   # Isi dengan API key Resend di server

# ─── STORAGE ──────────────────────────────────────────────────────────────────
# File upload foto absen disimpan di storage/app/public
# Pastikan sudah run: php artisan storage:link
